# Normalise to LF in the repo; check out LF everywhere except Windows scripts.
* text=auto eol=lf

# Shell scripts must be LF or they fail on Linux CI with
# "bad interpreter: /bin/sh^M".
gradlew text eol=lf
*.sh text eol=lf

# Windows scripts want CRLF.
*.bat text eol=crlf

# Never touch binaries.
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.keystore binary
*.jks binary
